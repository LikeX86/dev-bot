# Discord (https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=1513392554408939681
DISCORD_GUILD_ID=

# Atlassian (conta de teste — NÃO usar credenciais da equipe Arpenium)
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=

# Jira Cloud (ex.: https://seu-workspace.atlassian.net)
JIRA_BASE_URL=
JIRA_PROJECT_KEY=

# Modo de auth do Jira: "basic" (token clássico) ou "gateway" (token com scopes)
JIRA_AUTH_MODE=basic
# Necessário apenas quando JIRA_AUTH_MODE=gateway
JIRA_CLOUD_ID=

# Transições/status (nome exato no workflow)
JIRA_TRANSITION_ON_LINK=Em análise
JIRA_TRANSITION_ON_COMPLETE=Concluído
JIRA_STATUS_IN_PROGRESS=Em andamento

# Opcional: restringe os botões de status a um cargo do Discord
# TECHLEAD_ROLE_ID=

# Bitbucket Cloud (ex.: likex)
BITBUCKET_WORKSPACE=
# Opcional: token separado para Bitbucket (senão usa ATLASSIAN_API_TOKEN)
BITBUCKET_API_TOKEN=
